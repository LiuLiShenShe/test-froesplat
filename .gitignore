# ===== 大文件 / 数据产物（全部排除）=====
# 图像与视频数据
*.jpeg
*.tif
*.tiff
*.bmp
*.mp4
*.avi
*.mov
*.mkv
*.gif
*.rgba
*.rgba_backup
*.exr
*.hdr

# 3D / COLMAP / 点云产物
*.ply
*.bin
*.obj
*.glb
*.gltf
*.npy
*.npz
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors

# 压缩包与大文档
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ===== Python 运行产物 =====
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
build/
dist/

# ===== 编译产物 =====
*.so
*.o
*.a
*.lib
*.dll
*.exe

# ===== 日志与临时文件 =====
*.log
nohup.out
.lock/
.tmp/

# ===== 系统文件 =====
.DS_Store
*.db
*.db.bak

# ===== 超大文本产物（>50MB，超 GitHub 100MB 限制风险）=====
fuse.ply.vis
10-Instant-NGP/*/colmap_text/images.txt

# ---------- 图像排除规则 ----------
# 默认排除所有 png/jpg/jpeg 等大图像（数据文件，不进版本库）
*.jpeg
*.png
*.jpg

# ---------- 例外：00-论文优化重构 下的图片需纳入版本控制 ----------
# 用户要求上传该目录图片；单文件最大 25.5MB，未超 GitHub 100MB 限制
!00-论文优化重构/**/*.png
!00-论文优化重构/**/*.jpg
!00-论文优化重构/**/*.jpeg
