+// PCG returns scalars to host memory. Own its cuBLAS state and default
+// workspace instead of inheriting PyTorch's mutable pooled handle state.
+struct PCGCublasContext {
+    cublasHandle_t handle = nullptr;
+    explicit PCGCublasContext(cudaStream_t stream) {
+        cublasSafeCall(cublasCreate(&handle));
+        cublasSafeCall(cublasSetStream(handle, stream));
+        cublasSafeCall(cublasSetPointerMode(handle, CUBLAS_POINTER_MODE_HOST));
+    }
+    ~PCGCublasContext() { if (handle) cublasDestroy(handle); }
+};
